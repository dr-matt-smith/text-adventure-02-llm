# A shell console. When it opens it runs "deno task dev": build the game into dist/, run the tests,
# write test_output/, then watch src/, public/ and tests/ and do it all again on every save.
[session]
type = "shell"

[session.shell]
script = "deno task dev"

[[session.shortcut]]
label = "build, test, and watch for changes (press Ctrl+C first if it is already running)"
icon = "bs-arrow-repeat"
text = "deno task dev"

[[session.shortcut]]
label = "build the game into dist/ and test, once"
icon = "bs-hammer"
text = "deno task build"

[[session.shortcut]]
label = "run the tests, once"
icon = "bs-clipboard-check"
text = "deno task test"

[[session.shortcut]]
label = "lint: look for likely mistakes and bad habits"
icon = "bs-search"
text = "deno task lint"

[[session.shortcut]]
label = "serve the game at http://127.0.0.1:8000/"
icon = "bs-globe"
text = "deno task serve"

[[session.shortcut]]
label = "start LM Studio's LLM server, with CORS on, so the game can understand free text"
icon = "bs-chat-dots"
text = "~/.lmstudio/bin/lms server start --cors"
